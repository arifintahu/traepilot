# TraePilot environment variables
# Copy to .env and fill in values from your Trae IDE installation
# Run: python auth.py to extract TRAE_IDE_TOKEN and TRAE_MACHINE_ID automatically

# Upstream Trae API
TRAE_BASE_URL=https://coresg-normal.trae.ai

# Proxy bind settings (keep on 127.0.0.1 — do NOT expose publicly)
BIND_HOST=127.0.0.1
BIND_PORT=8787

# Optional: set to require Bearer token on proxy requests
API_KEY=

# Dashboard login password (separate from API_KEY). Required if hosting publicly.
DASHBOARD_PASSWORD=
# Optional: persistent cookie-signing secret. If unset, a random one is generated
# at startup (dashboard sessions are invalidated on restart).
SESSION_SECRET=

# Optional: path for the usage tracking SQLite DB (default: usage.db in project root)
# USAGE_DB=usage.db

# Optional: comma-separated model ids to hide from /v1/models (those that error
# for your account). Default hides the Claude ids that return 4023 without access.
TRAE_EXCLUDE_MODELS=claude3.5,aws_sdk_claude37_sonnet

# Trae IDE identity headers — auto-fill with: python auth.py --write
# TRAE_IDE_VERSION is optional: Trae omits it on the chat endpoint, so it stays
# blank (empty headers are dropped automatically).
# The Authorization header is derived from TRAE_IDE_TOKEN (no separate var).
TRAE_APP_ID=
TRAE_DEVICE_BRAND=
TRAE_DEVICE_CPU=
TRAE_DEVICE_ID=
TRAE_DEVICE_TYPE=
TRAE_IDE_TOKEN=
TRAE_IDE_VERSION=
TRAE_IDE_VERSION_CODE=
TRAE_MACHINE_ID=
TRAE_OS_VERSION=
TRAE_PLUGIN_CHANNEL=icube-ai